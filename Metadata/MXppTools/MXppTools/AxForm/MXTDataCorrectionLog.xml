					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            Dialog      dialog   = new Dialog("@MXT:DataCorrectionClean");
            DialogField keepDays = dialog.addFieldValue(extendedTypeStr(Days), 90, "@MXT:DataCorrectionCleanDays");

            if (dialog.run())
            {
                MXTDataCorrectionLog::deleteOlderThan(keepDays.value());

                MXTDataCorrectionLog_ds.research(false);
            }
        }

]]></Source>
